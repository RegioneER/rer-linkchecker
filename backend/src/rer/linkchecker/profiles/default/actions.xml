<?xml version="1.0"?>
<object name="portal_actions" meta_type="Plone Actions Tool"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n">
    <object name="user" meta_type="CMF Action Category" purge="False">
        <object name="rer-linkchecker" meta_type="CMF Action" i18n:domain="rer.linkchecker" insert-before="logout">
            <property name="title" i18n:translate="">Check links</property>
            <property name="description" i18n:translate=""></property>
            <property name="url_expr">string:/controlpanel/linkchecker</property>
            <property name="icon_expr"></property>
            <property name="available_expr">python:member is not None</property>
            <property name="permissions">
                <element value="rer.linkchecker: View report"/>
            </property>
            <property name="visible">True</property>
        </object>
    </object>
</object>
