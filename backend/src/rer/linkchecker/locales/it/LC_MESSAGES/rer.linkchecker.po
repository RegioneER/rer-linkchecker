msgid "action_fix"
msgstr "Correggi"

#. Default: "To update"
#: rer/linkchecker/linkchecker.py:201
msgid "action_update"
msgstr "Aggiorna"

#. Default: "Link actions"
#: rer/linkchecker/linkchecker.py:193
msgid "column_action"
msgstr "Azioni sui link"

#. Default: "Link to check"
#: rer/linkchecker/linkchecker.py:189
msgid "column_link"
msgstr "Link da controllare"

#. Default: "Link type"
#: rer/linkchecker/linkchecker.py:190
msgid "column_link_type"
msgstr "Tipo di link"

#. Default: "Site content"
#: rer/linkchecker/linkchecker.py:188
msgid "column_page"
msgstr "Contenuto del sito"

#. Default: "Outcome"
#: rer/linkchecker/linkchecker.py:191
msgid "column_status"
msgstr "Esito"

#. Default: "Outcome description"
#: rer/linkchecker/linkchecker.py:192
msgid "column_status_description"
msgstr "Descrizione esito"

#. Default: "External"
#: rer/linkchecker/linkchecker.py:197
msgid "link_type_external"
msgstr "Esterno"

#. Default: "Internal"
#: rer/linkchecker/linkchecker.py:196
msgid "link_type_internal"
msgstr "Interno"

#. Default: "Bad request"
#: rer/linkchecker/linkchecker.py:139
msgid "status_400"
msgstr "Richiesta non valida"

#. Default: "Unauthorized"
#: rer/linkchecker/linkchecker.py:140
msgid "status_401"
msgstr "Accesso non autorizzato"

#. Default: "Request blocked (forbidden)"
#: rer/linkchecker/linkchecker.py:141
msgid "status_403"
msgstr "Accesso negato"

#. Default: "Not Found"
#: rer/linkchecker/linkchecker.py:142
msgid "status_404"
msgstr "Risorsa non trovata"

#. Default: "Check method not allowed"
#: rer/linkchecker/linkchecker.py:143
msgid "status_405"
msgstr "Richiesta non consentita"

#. Default: "Gone"
#: rer/linkchecker/linkchecker.py:144
msgid "status_410"
msgstr "Risorsa rimossa"

#. Default: "Check blocked: too many requests"
#: rer/linkchecker/linkchecker.py:145
msgid "status_429"
msgstr "Verifica bloccata per troppe richieste"

#. Default: "Internal server error on the target server"
#: rer/linkchecker/linkchecker.py:146
msgid "status_500"
msgstr "Errore del server di destinazione"

#. Default: "Service temporarily unavailable"
#: rer/linkchecker/linkchecker.py:147
msgid "status_503"
msgstr "Servizio temporaneamente non disponibile"

#. Default: "Target server is down"
#: rer/linkchecker/linkchecker.py:148
msgid "status_521"
msgstr "Server di destinazione non raggiungibile"

#. Default: "Invalid SSL certificate"
#: rer/linkchecker/linkchecker.py:149
msgid "status_526"
msgstr "Certificato di sicurezza non valido"

#. Default: "Domain not allowed in contents (e.g. the editorial backend): replace the link"
#: rer/linkchecker/linkchecker.py:162
msgid "status_blacklisted"
msgstr "Dominio non ammesso nei contenuti (es. il backend redazionale): sostituisci il link"

#. Default: "Blocked by bot protection (works for a human, not verifiable)"
#: rer/linkchecker/linkchecker.py:169
msgid "status_blocked"
msgstr "Bloccato dalla protezione anti-bot (funziona per un utente, non verificabile)"

#. Default: "Connection error (host unreachable, DNS failure, ...)"
#: rer/linkchecker/linkchecker.py:158
msgid "status_connection_error"
msgstr "Errore di connessione (es. errore DNS, host non raggiungibile, ecc.)"

#. Default: "Broken over http but works over https: update the link"
#: rer/linkchecker/linkchecker.py:154
msgid "status_https_only"
msgstr "Link da aggiornare a HTTPS"

#. Default: "Timeout (server too slow; try raising the timeout)"
#: rer/linkchecker/linkchecker.py:150
msgid "status_timeout"
msgstr "Risposta troppo lenta (Timeout)"
